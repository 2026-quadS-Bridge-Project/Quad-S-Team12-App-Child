<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required for the Screen Time based AppBlocker (FamilyControls /
	  ManagedSettings). Enable the matching "Family Controls" capability on the
	  Runner target in Xcode ▸ Signing & Capabilities so this entitlement is
	  linked into the build and provisioning profile.
	-->
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>
